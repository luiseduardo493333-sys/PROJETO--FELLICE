PROJECT_NAME="Pizzaria Fellice - Controle de Estoque"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Segredos JWT
SECRET_KEY="fellice-super-secret-key-change-in-production-random-jwt-token"
